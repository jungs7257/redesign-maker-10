DATABASE_URL="<YOUR_NEON_POSTGRES_CONNECTION_URL>"
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"
GOOGLE_API_KEY="<YOUR_GOOGLE_API_KEY>"
OPENAI_ANALYSIS_MODEL="gpt-5.5"

# 방식 B: 서버 키 기본 사용(이름만 적는다. 실제 값은 절대 커밋 금지)
KIE_API_KEY="<YOUR_KIE_API_KEY>"
ZAI_API_KEY="<YOUR_ZAI_API_KEY>"
FLUX_API_KEY="<YOUR_FLUX_API_KEY>"
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY>"

# 분석(텍스트) 단계 제공자: 기본 GLM(ZAI_API_KEY), "deepseek"이면 DEEPSEEK_API_KEY 사용
KIE_ANALYSIS_PROVIDER="glm"
KIE_ANALYSIS_MODEL="glm-4.6v"
DEEPSEEK_API_KEY="<YOUR_DEEPSEEK_API_KEY>"
DEEPSEEK_ANALYSIS_MODEL="deepseek-chat"
KNOWLEDGE_ACCESS_KEYS="<COMMA_SEPARATED_ACCESS_KEYS>"
KNOWLEDGE_ADMIN_KEY="<KNOWLEDGE_ADMIN_KEY>"
