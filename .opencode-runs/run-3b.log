from PIL import Image

def bands(path):
    im = Image.open(path).convert('L')  # 흑백
    w, h = im.size
    px = im.load()
    rows = []
    for y in range(0, h, 8):
        dark = sum(1 for x in range(0, w, 4) if px[x, y] < 128)
        rows.append(dark)
    return w, h, rows

for name in ['snap-baseline', 'snap-p3']:
    w, h, rows = bands(f'/tmp/opencode/pngtest/downloads-verify/{name}.png')
    text_rows = [i for i, d in enumerate(rows) if d > 5]
    print(name, f'{w}x{h}', '텍스트 라인 밴드:', text_rows[:12])
